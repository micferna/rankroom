# Copy to .env and fill in. Never commit the result.
#
#   cp .env.example .env
#   docker compose up -d --build

# Where the whole application answers, app and API alike. Must match what your
# reverse proxy serves, exactly — it builds the Twitch redirect URL.
PUBLIC_URL=https://rankroom.runship.fr

# Postgres password. Generate one and keep it here:
#   openssl rand -base64 32
#
# Set it before the first `docker compose up`. Postgres only reads it when it
# initialises the data directory, so changing it later does nothing — the
# database keeps the old one and the app fails to authenticate. To rotate it,
# change it inside the running database:
#   docker compose exec db psql -U rankroom -c "\password rankroom"
DB_PASSWORD=

# --- sign-in (optional) -----------------------------------------------------
#
# Without these the app runs and boards work; nobody can create an account.
# Create an application at https://dev.twitch.tv/console/apps and set its
# OAuth Redirect URL to exactly:  <PUBLIC_URL>/api/auth/twitch/callback
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- your obligations as the host -------------------------------------------

# Hosting accounts makes you the data controller for them. The privacy page at
# /#/privacy describes what this software stores and for how long — it is
# accurate and a test keeps it that way — but it cannot name you. Put an address
# here and it appears on that page; leave it empty and the page says plainly
# that no contact has been published.
#
# Baked in at build time, so `docker compose up -d --build` after changing it.
PRIVACY_CONTACT=

# --- backups ----------------------------------------------------------------

# Dumps land in ./backups, verified by reading each one back before it is kept.
# They contain every account and every board: treat that directory like the
# database itself, and copy it somewhere that is not this machine — a backup on
# the same disk covers a bad migration and nothing else.
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP_DAYS=14

# --- tuning -----------------------------------------------------------------

SESSION_TTL_DAYS=30
RATE_LIMIT_PER_SECOND=10
RATE_LIMIT_BURST=40

# Megabytes of board documents one account may store.
STORAGE_QUOTA_MB=512

RUST_LOG=rankroom_server=info,tower_http=warn
