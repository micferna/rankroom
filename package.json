{
  "name": "rankroom",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "The ranking studio for content creators \u2014 tier lists with duel sorting, a live stream mode, an OBS overlay and exportable animated replays.",
  "license": "MIT",
  "author": "micferna",
  "homepage": "https://micferna.github.io/rankroom/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/micferna/rankroom.git"
  },
  "bugs": {
    "url": "https://github.com/micferna/rankroom/issues"
  },
  "keywords": [
    "tier-list",
    "ranking",
    "obs-overlay",
    "streaming",
    "content-creation",
    "react",
    "typescript"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --build --force && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --build --force",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "assets": "node --experimental-strip-types build/make-assets.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "build:app": "tsc --build tsconfig.app.json --force && vite build"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/modifiers": "9.0.0",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/node": "24.10.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.9.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.3.5",
    "vitest": "4.1.10"
  }
}
