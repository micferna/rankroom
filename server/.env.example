# Copy to .env and fill in. Never commit the result.

# --- required ---------------------------------------------------------------

# Postgres. Use a dedicated role that owns only this database.
DATABASE_URL=postgres://rankroom:CHANGE_ME@127.0.0.1:5432/rankroom

# Where this deployment is reachable from the internet. Used to build the OAuth
# redirect, so it must match what you registered with Twitch, exactly.
PUBLIC_URL=https://rankroom.runship.fr

# Where the front end lives. The same host, when this server also serves it —
# which is the arrangement that keeps the session cookie SameSite=Lax.
APP_URL=https://rankroom.runship.fr

# The built front end. Set, this server serves the app as well as the API, from
# one origin. Unset, it is an API and nothing else.
STATIC_DIR=/app/web

# --- sign-in (optional) -----------------------------------------------------
#
# Without these the server still serves public boards; nobody can sign in.
# Create an application at https://dev.twitch.tv/console/apps and set its
# OAuth Redirect URL to exactly: <PUBLIC_URL>/api/auth/twitch/callback
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- tuning -----------------------------------------------------------------

# Origins allowed to call this API, comma separated. Defaults to APP_URL's
# origin. Anything not listed is refused — keep this tight.
# ALLOWED_ORIGINS=https://micferna.github.io

BIND=0.0.0.0:8080
SESSION_TTL_DAYS=30

# Requests per second per client, and how big a burst is tolerated.
#
# Keyed on X-Forwarded-For when present, so your reverse proxy MUST overwrite
# that header rather than append to it — otherwise a caller sets their own and
# gets a fresh bucket per request. nginx: `proxy_set_header X-Forwarded-For
# $remote_addr;` (not `$proxy_add_x_forwarded_for`). Caddy overwrites by default.
RATE_LIMIT_PER_SECOND=10
RATE_LIMIT_BURST=40

# Total megabytes of board documents one account may store. A board count on
# its own bounds nothing: a signed-in user within every other limit can still
# fill the disk.
STORAGE_QUOTA_MB=512

# Only for local development over plain HTTP. Drops the Secure flag on cookies
# and, with it, the __Host- prefix that stops a sibling subdomain from shadowing
# a session. Setting this in production hands sessions to anyone on the network.
# INSECURE_COOKIES=true

RUST_LOG=rankroom_server=info,tower_http=warn
